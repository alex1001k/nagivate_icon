        <mxCell id="e6" value="обновление алгоритмов из библиотеки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.2;entryX=0;entryY=0.7;strokeColor=#3E7D4F;strokeWidth=2;endArrow=block;endFill=1;fontColor=#2E6B44;fontStyle=1;fontSize=12;labelBackgroundColor=#EAF1EC;" edge="1" parent="1" source="n_lib" target="n_an"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e7" value="часть метрик — требует объяснения" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3E7D4F;strokeWidth=2.2;endArrow=block;endFill=1;fontColor=#9C6B14;fontStyle=1;fontSize=12;labelBackgroundColor=#FBF0DC;" edge="1" parent="1" source="n_out" target="n_drv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="остальное — норма" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;strokeWidth=1.8;dashed=1;dashPattern=6 5;endArrow=block;endFill=1;fontColor=#5A5A52;fontStyle=1;fontSize=11.5;labelBackgroundColor=#F1F0EC;" edge="1" parent="1" source="n_out" target="n_norma"><mxGeometry relative="1" as="geometry"/></mxCell>

