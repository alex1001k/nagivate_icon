        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3E7D4F;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n_prod" target="n_an"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3E7D4F;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n_prod" target="n_mon"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3E7D4F;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1" source="n_an" target="n_out"><mxGeometry relative="1" as="geometry"/></mxCell>
