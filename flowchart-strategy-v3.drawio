        <!-- ══════ БАНД 1: НАБЛЮДЕНИЕ ══════ -->

        <mxCell id="n_src" value="&lt;b&gt;Источники данных&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal;color:#777;&quot;&gt;A: транзакции · B: клиенты · C: внешние&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12352A;strokeWidth=1.8;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="95" width="520" height="85" as="geometry" />
        </mxCell>
        <mxCell id="nt_src" value="&lt;b&gt;Нужно:&lt;/b&gt; подключение источников, единая схема / онтология данных&lt;br&gt;&lt;br&gt;&lt;b&gt;Результат:&lt;/b&gt; данные доступны для агрегации вокруг продукта" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#D8D6CC;strokeWidth=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1100" y="95" width="520" height="85" as="geometry" />
        </mxCell>

        <mxCell id="n_prod" value="&lt;b&gt;Продукт&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal;color:#777;&quot;&gt;бизнес-сущность, окружённая данными&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12352A;strokeWidth=2.4;fontSize=17;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="220" width="520" height="95" as="geometry" />
        </mxCell>
        <mxCell id="nt_prod" value="&lt;b&gt;Нужно:&lt;/b&gt; онтология продукта, карта связанных сущностей&lt;br&gt;&lt;br&gt;&lt;b&gt;Результат:&lt;/b&gt; единая точка сборки данных вокруг продукта" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#D8D6CC;strokeWidth=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1100" y="220" width="520" height="95" as="geometry" />
        </mxCell>

        <mxCell id="n_an" value="&lt;b&gt;Поиск отклонений и связей&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#777;&quot;&gt;аномалии · корреляции · зависимости&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12352A;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="355" width="260" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n_mon" value="&lt;b&gt;Мониторинг метрик в динамике&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#777;&quot;&gt;тренды, сезонность, без немедленного триггера&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12352A;strokeWidth=2;fontSize=14.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="355" width="240" height="105" as="geometry" />
        </mxCell>
        <mxCell id="nt_an" value="&lt;b&gt;Нужно:&lt;/b&gt; агент анализа + стандартные алгоритмы (библиотека) для отклонений; дашборд / тайм-серии для динамики&lt;br&gt;&lt;br&gt;&lt;b&gt;Результат:&lt;/b&gt; список отклонений и зависимостей с оценкой значимости + видимость трендов в динамике" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#D8D6CC;strokeWidth=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1100" y="355" width="520" height="105" as="geometry" />
        </mxCell>

        <mxCell id="n_out" value="&lt;b&gt;Наблюдение: результат&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#666;&quot;&gt;статус метрики: норма / отклонение / новая связь&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF1EC;strokeColor=#12352A;strokeWidth=2.4;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="495" width="520" height="85" as="geometry" />
        </mxCell>
        <mxCell id="nt_out" value="&lt;b&gt;Нужно:&lt;/b&gt; агрегация сигналов анализа и мониторинга&lt;br&gt;&lt;br&gt;&lt;b&gt;Результат:&lt;/b&gt; статус метрики готов к передаче в исследование" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#D8D6CC;strokeWidth=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1100" y="495" width="520" height="85" as="geometry" />
        </mxCell>

        <!-- ══════ БАНД 2: ИССЛЕДОВАНИЕ ══════ -->

        <mxCell id="n_norma" value="&lt;b&gt;Норма — цикл закрыт&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;color:#777;&quot;&gt;порог значимости не пройден. Результат: ресурсы investigation не тратятся&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1F0EC;strokeColor=#7A7A72;strokeWidth=1.6;dashed=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="340" height="85" as="geometry" />
        </mxCell>

        <mxCell id="n_drv" value="&lt;b&gt;Определение драйверов&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#777;&quot;&gt;анализ всех метрик, выделение ключевых драйверов&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12352A;strokeWidth=2;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="670" width="520" height="105" as="geometry" />
        </mxCell>
        <mxCell id="nt_drv" value="&lt;b&gt;Нужно:&lt;/b&gt; агент факторного анализа, доступ ко всем метрикам продукта&lt;br&gt;&lt;br&gt;&lt;b&gt;Результат:&lt;/b&gt; ранжированный список ключевых драйверов отклонения" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#D8D6CC;strokeWidth=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1100" y="670" width="520" height="105" as="geometry" />
        </mxCell>

        <mxCell id="n_rec_known" value="&lt;b&gt;Известный драйвер&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#777;&quot;&gt;поиск похожего паттерна в библиотеке&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12352A;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="815" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_rec_new" value="&lt;b&gt;Новый драйвер&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#777;&quot;&gt;генерация: агент + аналогия / эксперт / бенчмарки&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12352A;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="815" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="nt_rec" value="&lt;b&gt;Нужно:&lt;/b&gt; известный — библиотека паттернов; новый — агент-генератор (модель + онтология), поиск по аналогии, эксперт (human-in-the-loop) или отраслевые бенчмарки&lt;br&gt;&lt;br&gt;&lt;b&gt;Результат:&lt;/b&gt; набор кандидатов-рекомендаций под каждый драйвер&lt;br&gt;&lt;br&gt;&lt;i&gt;Обе ветки после подтверждения гипотезы пополняют библиотеку&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#D8D6CC;strokeWidth=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1100" y="815" width="520" height="110" as="geometry" />
        </mxCell>

        <mxCell id="n_syn" value="&lt;b&gt;Синтез гипотез&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#777;&quot;&gt;синтез данных на уровне моделей, формирование рабочих гипотез&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12352A;strokeWidth=2;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="965" width="520" height="105" as="geometry" />
        </mxCell>
        <mxCell id="nt_syn" value="&lt;b&gt;Нужно:&lt;/b&gt; синтез на уровне моделей, онтология причинно-следственных связей&lt;br&gt;&lt;br&gt;&lt;b&gt;Результат:&lt;/b&gt; рабочие гипотезы — причина → действие → ожидаемый эффект" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#D8D6CC;strokeWidth=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1100" y="965" width="520" height="105" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="Что делаем с гипотезой?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9C6B14;strokeWidth=2.2;fontSize=14;fontStyle=1;fontColor=#6B4E10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="655" y="1130" width="250" height="150" as="geometry" />
        </mxCell>

        <mxCell id="n_exp" value="&lt;b&gt;Эксперимент: пилот / АБ-тест&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#777;&quot;&gt;проверка на части аудитории&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#12352A;strokeWidth=2;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="1330" width="520" height="105" as="geometry" />
        </mxCell>
        <mxCell id="nt_exp" value="&lt;b&gt;Нужно:&lt;/b&gt; агент постановки эксперимента, доступ к сегменту аудитории&lt;br&gt;&lt;br&gt;&lt;b&gt;Результат:&lt;/b&gt; измеренный эффект гипотезы на выборке" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#D8D6CC;strokeWidth=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1330" width="520" height="105" as="geometry" />
        </mxCell>

        <mxCell id="n_lib" value="&lt;b&gt;Библиотека исследований и знаний&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;color:#7A6A45;&quot;&gt;гипотезы, алгоритмы, подтверждённые и опровергнутые исходы&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3EEDF;strokeColor=#9C6B14;strokeWidth=2.2;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="1330" width="400" height="145" as="geometry" />
        </mxCell>
        <mxCell id="nt_lib" value="&lt;b&gt;Нужно:&lt;/b&gt; регулярная модерация и тегирование (агент / аналитик)&lt;br&gt;&lt;br&gt;&lt;b&gt;Результат:&lt;/b&gt; растущая база знаний, обновляет алгоритмы наблюдения и рекомендации каждый цикл" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#D8D6CC;strokeWidth=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="1495" width="400" height="95" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="Гипотеза подтвердилась?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9C6B14;strokeWidth=2.2;fontSize=14;fontStyle=1;fontColor=#6B4E10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="665" y="1480" width="230" height="140" as="geometry" />
        </mxCell>

        <!-- ══════ БАНД 3: УПРАВЛЕНИЕ ══════ -->

        <mxCell id="n_act" value="&lt;b&gt;Действие / внедрение&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#666;&quot;&gt;решение применяется к продукту&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF1EC;strokeColor=#12352A;strokeWidth=2.2;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="1695" width="520" height="95" as="geometry" />
        </mxCell>
        <mxCell id="nt_act" value="&lt;b&gt;Нужно:&lt;/b&gt; владелец продукта / процесса, ресурс на внедрение&lt;br&gt;&lt;br&gt;&lt;b&gt;Результат:&lt;/b&gt; решение запущено в продукте" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#D8D6CC;strokeWidth=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1695" width="520" height="95" as="geometry" />
        </mxCell>

        <mxCell id="n_new" value="&lt;b&gt;Новый набор действий&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#666;&quot;&gt;изменения в бизнес-алгоритмах / процессах&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF1EC;strokeColor=#12352A;strokeWidth=2.4;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="1830" width="520" height="95" as="geometry" />
        </mxCell>
        <mxCell id="nt_new" value="&lt;b&gt;Нужно:&lt;/b&gt; фиксация конфигурации изменений&lt;br&gt;&lt;br&gt;&lt;b&gt;Результат:&lt;/b&gt; обновлённый набор бизнес-алгоритмов, готов к мониторингу эффекта" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#D8D6CC;strokeWidth=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1830" width="520" height="95" as="geometry" />
        </mxCell>

